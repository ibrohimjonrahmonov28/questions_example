# --- required
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=elpat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://elpat.example.com
ANTHROPIC_API_KEY=sk-ant-...

# --- speech-to-text for recorded answers: openai | deepgram
ELPAT_STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# ELPAT_STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# --- optional
# ELPAT_ACCESS_CODE=pilot2026        # ask candidates for a shared code before they can use your API credit
# ELPAT_MODEL=claude-opus-5-5
# ELPAT_MAX_AUDIO_MB=20
# ELPAT_RATE_CLAUDE=120              # Claude requests per 10 minutes per IP
# ELPAT_RATE_STT=120                 # transcriptions per 10 minutes per IP
# REDIS_URL=redis://localhost:6379/0 # shared rate limits when running several instances
# DJANGO_DEBUG=1                     # local development only (http://localhost)
